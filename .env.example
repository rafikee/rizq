# Alpaca PAPER trading credentials only.
# Live keys MUST NOT be stored in this file or anywhere in this repo.
# Get paper keys from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Market data (optional for now — used when data ingestion is wired up).
DATABENTO_API_KEY=

# Always "paper". Live mode is not implemented.
RIZQ_MODE=paper

# Local-dev DB path. In production this is /data/rizq.db (Coolify-mounted volume).
DATABASE_PATH=./data/rizq.db

LOG_LEVEL=INFO
